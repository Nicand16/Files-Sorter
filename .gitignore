__pycache__/
*.py[cod]
*$py.class
.venv/
.env
**/.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime state (now written to %APPDATA%\Briner when frozen)
briner_agent/**/user_settings.json
briner_agent/logs/
briner_agent/**/logs/
briner_agent/db/*.db
briner_agent/**/*.db

# PyInstaller build artifacts (temp files, not needed)
briner_agent/build/

# Local files organized during development
briner_agent/workspace/*
!briner_agent/workspace/.keep

# OS/editor noise
Thumbs.db
desktop.ini
.DS_Store
